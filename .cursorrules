### Example Story: "A Day at the Souk"

```typescript
const soukAdventure: Story = {
  id: 'souk_adventure',
  title: 'يوم في السوق',
  titleEn: 'A Day at the Souk',
  description: 'Explore Marrakech souk and interact with various people',
  level: 4,
  duration: 30,
  
  characters: [
    characters.find(c => c.id === 'ahmed_taxi'),
    characters.find(c => c.id === 'hassan_vendor'),
    characters.find(c => c.id === 'sophie_tourist'),
    characters.find(c => c.id === 'karim_police'),
  ],
  
  scenes: [
    // SCENE 1: In the Taxi
    {
      id: 'scene_1_taxi',
      sceneNumber: 1,
      location: 'في التاكسي',
      locationEn: 'In the Taxi',
      background: {
        image: '/backgrounds/taxi-interior.jpg',
        style: 'illustrated',
      },
      audio: {
        background: 'traffic-ambient.mp3',
        character: 'radio-arabic-low.mp3',
        events: [
          { trigger: 'ahmed_speaks', sound: 'car-indicator.mp3', volume: 0.3 },
          { trigger: 'user_asks_price', sound: 'meter-beep.mp3', volume: 0.5 },
          { trigger: 'scene_end', sound: 'car-door-close.mp3', volume: 0.8 },
        ],
      },
      activeCharacter: 'ahmed_taxi',
      objectives: [
        'Saluer le chauffeur',
        'Indiquer destination (السوق)',
        'Discuter du prix',
        'Faire conversation (météo, ville)',
      ],
      nextScene: 'scene_2_souk_entrance',
    },
    
    // SCENE 2: Souk Entrance
    {
      id: 'scene_2_souk_entrance',
      sceneNumber: 2,
      location: 'مدخل السوق',
      locationEn: 'Souk Entrance',
      background: {
        image: '/backgrounds/souk-entrance.jpg',
        style: 'illustrated',
      },
      audio: {
        background: 'souk-crowd-loop.mp3',
        character: 'spices-pouring.mp3',
        events: [
          { trigger: 'hassan_shows_saffron', sound: 'jar-open.mp3', volume: 0.4 },
          { trigger: 'negotiation_starts', sound: 'merchant-call-distant.mp3', volume: 0.3 },
          { trigger: 'purchase_complete', sound: 'coins-jingle.mp3', volume: 0.6 },
        ],
      },
      activeCharacter: 'hassan_vendor',
      objectives: [
        'Approcher l\'étal d\'épices',
        'Demander prix du safran',
        'Négocier',
        'Acheter ou refuser poliment',
      ],
      nextScene: (userChoices) => {
        if (userChoices.includes('acheter')) {
          return 'scene_3a_shopping_more';
        } else {
          return 'scene_3b_get_lost';
        }
      },
    },
    
    // SCENE 3B: Lost in Souk (Branching path)
    {
      id: 'scene_3b_get_lost',
      sceneNumber: 3,
      location: 'ضاع في السوق',
      locationEn: 'Lost in the Souk',
      background: {
        image: '/backgrounds/souk-alley.jpg',
        style: 'illustrated',
      },
      audio: {
        background: 'distant-voices.mp3',
        events: [
          { trigger: 'tourist_approaches', sound: 'camera-click.mp3', volume: 0.4 },
          { trigger: 'map_unfold', sound: 'map-unfold.mp3', volume: 0.5 },
        ],
      },
      activeCharacter: 'sophie_tourist',
      objectives: [
        'Une touriste te demande son chemin',
        'Essayer de l\'aider en arabe',
        'Utiliser vocabulaire: يمين (droite), يسار (gauche), مستقيم (tout droit)',
      ],
      nextScene: 'scene_4_police',
    },
    
    // SCENE 4: With the Police Officer
    {
      id: 'scene_4_police',
      sceneNumber: 4,
      location: 'مع الشرطي',
      locationEn: 'With the Police Officer',
      background: {
        image: '/backgrounds/police-stand.jpg',
        style: 'illustrated',
      },
      audio: {
