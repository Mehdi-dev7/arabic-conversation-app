### Real-Time Correction System
```typescript
// Correction during conversation (inline)
interface Correction {
  userInput: string;      // "أنا ذهب إلى السوق أمس"
  corrected: string;      // "أنا ذهبتُ إلى السوق أمس"
  explanation: string;    // "ذهب = he went, ذهبتُ = I went (أنا)"
  errorType: 'conjugation' | 'vocabulary' | 'syntax' | 'pronunciation';
  severity: 'minor' | 'moderate' | 'major';
}

// AI response with correction
{
  message: "تقريباً صحيح! 👋 لكن الصيغة الصحيحة هي...",
  correction: Correction,
  continueConversation: true
}
```

### Subtitle System (Activatable/Deactivatable)

**PURPOSE:** Help absolute beginners who know basic grammar/conjugation but lack vocabulary to understand AI responses.

```typescript
interface SubtitleConfig {
  enabled: boolean;           // Show subtitles or not
  toggleable: boolean;        // Can user turn on/off?
  language: 'french' | 'english'; // Subtitle language
  position: 'below_message' | 'overlay'; // Placement
  style: 'subtle' | 'prominent'; // Visual style
  autoDetectLevel: boolean;   // Auto-enable for beginners?
}

// Level-specific subtitle defaults
const subtitlesByLevel = {
  vocabulary_acquisition: {
    enabled: true,            // ON by default (they need it!)
    toggleable: true,
    language: 'french',
    position: 'below_message',
    style: 'subtle',
  },
  
  comprehension: {
    enabled: false,           // OFF by default (testing comprehension)
    toggleable: true,         // But can turn on if struggling
    language: 'french',
    position: 'below_message',
    style: 'subtle',
  },
  
  assisted_conversation: {
    enabled: true,            // ON by default (assistance phase)
    toggleable: true,
    language: 'french',
    position: 'below_message',
    style: 'subtle',
  },
  
  immersion: {
    enabled: false,           // OFF completely (immersion = no crutches)
    toggleable: false,        // Can't turn on at this level
  },
};
```

### Subtitle UI Implementation

```tsx
// Message Bubble Component with Subtitles
<MessageBubble role="assistant" dir="rtl">
  {/* Main Arabic message */}
  <ArabicText className="text-lg font-arabic-body">
    مرحباً! كيف حالك اليوم؟
  </ArabicText>
  
  {/* Subtitle (if enabled) */}
  {showSubtitles && (
    <Subtitle 
      className="text-sm text-gray-500 italic mt-2 border-t border-dashed pt-2"
      dir="ltr"
    >
      Bonjour ! Comment vas-tu aujourd'hui ?
    </Subtitle>
  )}
</MessageBubble>

// Subtitle Toggle Button (in chat settings/toolbar)
<SubtitleToggle>
  <button 
    onClick={() => setShowSubtitles(!showSubtitles)}
    disabled={!currentLevel.subtitles.toggleable}
  >
    {showSubtitles ? (
      <>👁️ Masquer sous-titres</>
    ) : (
      <>🙈 Afficher sous-titres</>
    )}
  </button>
  
  {!currentLevel.subtitles.toggleable && (
    <Tooltip>Les sous-titres ne sont pas disponibles au niveau immersion</Tooltip>
  )}
</SubtitleToggle>
```

### AI Prompt for Subtitle Generation

```typescript
// System prompt addition for levels with subtitles
const systemPromptWithSubtitles = `
${baseSystemPrompt}

IMPORTANT - SUBTITLE FORMAT:
After each Arabic response, add a line break and provide a natural French translation.
Use this exact format:

[Your Arabic response]
TRADUCTION: [French translation]

Example:
مرحباً! كيف حالك؟ هل أنت جاهز لنتعلم؟
TRADUCTION: Bonjour ! Comment vas-tu ? Es-tu prêt à apprendre ?

Rules for translations:
- Natural, conversational French (not word-for-word)
- Keep it concise
- Don't translate proper nouns
- Use same tone as Arabic (formal/informal)
`;

// Parse AI response to separate Arabic and translation
function parseAIResponse(response: string): {
  arabic: string;
  translation: string | null;
} {
  const parts = response.split('TRADUCTION:');
  
  if (parts.length === 2) {
    return {
      arabic: parts[0].trim(),
      translation: parts[1].trim(),
    };
  }
  
  // Fallback if AI didn't provide translation
  return {
    arabic: response.trim(),
    translation: null,
  };
}

// Display logic
const { arabic, translation } = parseAIResponse(aiMessage);

return (
  <MessageBubble>
    <ArabicText>{arabic}</ArabicText>
    {showSubtitles && translation && (
      <Subtitle>{translation}</Subtitle>
    )}
  </MessageBubble>
);
```

