### Theme Dashboard UI

```tsx
<ThemeDashboard>
  {/* Warm-up status */}
  <WarmupStatus completed={user.warmupToday}>
    {user.warmupToday ? (
      <span>✅ Warm-up du jour complété (+5 XP)</span>
    ) : (
      <button onClick={startWarmup}>Commencer warm-up quotidien →</button>
    )}
  </WarmupStatus>
  
  {/* Level progress */}
  <LevelProgressBar>
    <Step completed={user.currentLevel >= 1}>
      Niveau 1: Vocabulaire {user.currentLevel === 1 && '🔄'}
    </Step>
    <Step completed={user.currentLevel >= 2}>
      Niveau 2: Compréhension {user.currentLevel === 2 && '🔄'}
    </Step>
    <Step locked={user.currentLevel < 3}>
      Niveau 3: Conversation {user.currentLevel === 3 && '🔄'} {user.currentLevel < 3 && '🔒'}
    </Step>
    <Step locked={user.currentLevel < 4}>
      Niveau 4: Immersion {user.currentLevel === 4 && '🔄'} {user.currentLevel < 4 && '🔒'}
    </Step>
  </LevelProgressBar>
  
  {/* Suggested theme */}
  <SuggestedTheme>
    <h3>📚 Suggestion du jour</h3>
    <ThemeCard theme={getNextTheme(user)}>
      {theme.icon} {theme.nameEn}
      <ProgressBar value={theme.progress} />
      <button>Continuer →</button>
    </ThemeCard>
  </SuggestedTheme>
  
  {/* All themes grid */}
  <ThemeGrid>
    {themes
      .filter(t => t.level <= user.currentLevel)
      .map(theme => (
        <ThemeCard 
          key={theme.id}
          locked={!theme.freeAccess && user.plan === 'free'}
        >
          <Icon>{theme.icon}</Icon>
          <Name>{theme.nameEn}</Name>
          <Progress>{theme.progress}%</Progress>
          
          {/* Expandable sub-themes */}
          <Collapsible>
            {theme.subthemes?.map(sub => (
              <SubThemeItem completed={sub.completed}>
                {sub.completed ? '✅' : '◻️'} {sub.nameEn}
                
                {/* Nested sub-themes */}
                {sub.subthemes && (
                  <NestedList>
                    {sub.subthemes.map(nested => (
                      <li>{nested.nameEn}</li>
                    ))}
                  </NestedList>
                )}
              </SubThemeItem>
            ))}
          </Collapsible>
          
          <ActionButton>
            {theme.freeAccess || user.plan === 'premium' ? (
              <span>Choisir →</span>
            ) : (
              <span>🔒 Premium</span>
            )}
          </ActionButton>
        </ThemeCard>
      ))}
  </ThemeGrid>
</ThemeDashboard>
```

## 🎭 INTERACTIVE STORIES (Multi-Character, Level 3-4 Only)

### Story System Architecture

```typescript
interface Story {
  id: string;
  title: string;          // Arabic title
  titleEn: string;        // French/English title
  description: string;
  level: 3 | 4;          // Advanced only
  duration: number;       // Estimated minutes
  characters: Character[];
  scenes: Scene[];
  achievements: Achievement[];
}

interface Character {
  id: string;
  name: string;          // Arabic name
  nameEn: string;        // French name
  role: string;          // 'taxi_driver', 'vendor', 'police', etc.
  personality: string;   // 'friendly', 'grumpy', 'helpful', 'rushed'
  dialect: 'msa' | 'darija';
  
  // Visual (halal-compliant)
  avatar: {
    type: 'svg' | 'lottie';
    file: string;        // Path to avatar file
    headShape: 'sphere' | 'oval'; // NO face
    accessories: string[]; // ['hat', 'uniform', 'scarf']
    dominantColor: string; // e.g., '#FFD700' for taxi
  };
  
  // Audio
  ambientSound?: string; // Character-specific sound (optional)
}

interface Scene {
  id: string;
  sceneNumber: number;
  location: string;      // Arabic location name
  locationEn: string;    // French location name
  background: {
    image: string;       // Background image path
    style: 'realistic' | 'illustrated' | 'minimal';
  };
  audio: SceneAudio;
  activeCharacter: string; // Character ID
  objectives: string[];  // What user should accomplish
  nextScene: string | ((userChoices: string[]) => string); // Next scene or branching
}

interface SceneAudio {
  background: string;    // Loop ambient sound
  character?: string;    // Character-specific sound
  events: {
    trigger: string;     // Event name
    sound: string;       // Sound file
    volume: number;      // 0-1
  }[];
}

interface Achievement {
  id: string;
  name: string;
  description: string;
  icon: string;
  condition: (storyState: any) => boolean;
}
```

### Character Visual Design (Halal-Compliant)

**MANDATORY RULES:**
- NO facial features (eyes, mouth, nose)
- Head = simple geometric shape (sphere, oval, glowing orb)
- Body = minimalist silhouette
- Identity through: clothing, accessories, colors, posture

**Character Examples:**

```typescript
const characters = [
  {
    id: 'ahmed_taxi',
    name: 'أحمد',
    nameEn: 'Ahmed (Taxi Driver)',
    role: 'taxi_driver',
    personality: 'Talkative and curious',
    dialect: 'darija',
    avatar: {
      type: 'svg',
      file: '/avatars/taxi-driver.svg',
      headShape: 'sphere',
      accessories: ['cap', 'steering_wheel'], // 🧢
      dominantColor: '#FFD700', // Yellow (taxi color)
    },
    ambientSound: 'radio-arabic-low.mp3',
