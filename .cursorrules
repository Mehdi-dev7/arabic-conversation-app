        {objectiveStates[i] ? '✅' : '⬜'} {obj}
      </Objective>
    ))}
  </ObjectivesSidebar>
  
  {/* Vocabulary helper (collapsible) */}
  <VocabularyHelper>
    <summary>💡 Vocabulaire utile</summary>
    <WordList>
      {getSceneVocabulary(currentScene).map(word => (
        <Word key={word.ar}>
          <span className="ar">{word.ar}</span> = 
          <span className="fr">{word.fr}</span>
        </Word>
      ))}
    </WordList>
  </VocabularyHelper>
  
  {/* Chat interface */}
  <ChatInterface>
    <MessageHistory>
      {messages.map(msg => (
        <MessageBubble 
          character={msg.character}
          text={msg.text}
          avatar={msg.character?.avatar}
        />
      ))}
    </MessageHistory>
    <ChatInput 
      placeholder="Réponds en arabe..."
      dir="rtl"
    />
  </ChatInterface>
</StoryMode>
