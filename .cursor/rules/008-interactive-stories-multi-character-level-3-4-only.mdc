### Audio System Implementation

```typescript
// Audio Manager with Howler.js
class StoryAudioManager {
  private backgroundLoop: Howl;
  private characterLoop?: Howl;
  private eventSounds: Map<string, Howl>;
  
  constructor(sceneAudio: SceneAudio) {
    // Background ambient (loop)
    this.backgroundLoop = new Howl({
      src: [`/audio/ambient/${sceneAudio.background}`],
      loop: true,
      volume: 0.4,
      html5: true, // Streaming for large files
    });
    
    // Character sound (loop, optional)
    if (sceneAudio.character) {
      this.characterLoop = new Howl({
        src: [`/audio/character/${sceneAudio.character}`],
        loop: true,
        volume: 0.2,
      });
    }
    
    // Preload event sounds
    sceneAudio.events.forEach(event => {
      this.eventSounds.set(event.trigger, new Howl({
        src: [`/audio/events/${event.sound}`],
        volume: event.volume,
      }));
    });
  }
  
  start() {
    this.backgroundLoop.play();
    this.characterLoop?.play();
  }
  
  playEvent(trigger: string) {
    const sound = this.eventSounds.get(trigger);
    if (sound) {
      sound.play();
    }
  }
  
  stop() {
    this.backgroundLoop.fade(0.4, 0, 1000); // Fade out 1s
    this.characterLoop?.fade(0.2, 0, 1000);
    setTimeout(() => {
      this.backgroundLoop.stop();
      this.characterLoop?.stop();
    }, 1000);
  }
  
  transition(newSceneAudio: SceneAudio) {
    // Crossfade between scenes
    this.stop();
    setTimeout(() => {
      const newManager = new StoryAudioManager(newSceneAudio);
      newManager.start();
      return newManager;
    }, 1000);
  }
}
```

### Character System Prompts (Multi-Character)

```typescript
// Dynamic system prompt per character
const buildCharacterPrompt = (character: Character, scene: Scene) => `
You are ${character.name} (${character.nameEn}), a ${character.role}.
Personality: ${character.personality}
Dialect: ${character.dialect === 'msa' ? 'Modern Standard Arabic' : 'Moroccan Darija'}

CURRENT SCENE: ${scene.locationEn}
Your role in this scene: ${getCharacterRole(character.id, scene)}

OBJECTIVES for the user (guide them naturally):
${scene.objectives.map((obj, i) => `${i + 1}. ${obj}`).join('\n')}

YOUR INSTRUCTIONS:
- Speak ONLY as ${character.name}
- Stay in character (personality: ${character.personality})
- Use ${character.dialect} dialect consistently
- React naturally to user's responses
- Guide user through objectives without being obvious
- Don't break the 4th wall
- When all objectives are naturally met, signal: [SCENE_COMPLETE]

SCENE CONTEXT:
${scene.description || ''}

Begin the scene naturally with an appropriate greeting or action.
`;

// Switch character = new system prompt
async function switchCharacter(
  newCharacter: Character, 
  scene: Scene,
  conversationHistory: Message[]
) {
  const systemPrompt = buildCharacterPrompt(newCharacter, scene);
  
  // Transition UI
  showCharacterTransition({
    character: newCharacter,
    location: scene.locationEn,
  });
  
  // First message from new character
  const greeting = await claude.messages.create({
    model: "claude-sonnet-4-20250514",
    system: systemPrompt,
    messages: [
      ...conversationHistory, // Keep context
      { role: "user", content: "[USER_ARRIVES_AT_SCENE]" }
    ],
  });
  
  return greeting;
}
```

### Story UI Components

```tsx
<StoryMode>
  {/* Scene header */}
  <SceneHeader>
    <LocationBadge>📍 {currentScene.locationEn}</LocationBadge>
    <ProgressBar>
      Scène {currentScene.sceneNumber}/{totalScenes}
    </ProgressBar>
  </SceneHeader>
  
  {/* Dynamic background */}
  <BackgroundImage 
    src={currentScene.background.image}
    style={currentScene.background.style}
  />
  
  {/* Ambient audio (auto-play) */}
  <AmbientAudio manager={audioManager} />
  
  {/* Active character (large, central) */}
  <CharacterDisplay>
    <CharacterAvatar
      character={activeCharacter}
      animation={isCharacterSpeaking ? 'talking' : 'idle'}
    />
    <CharacterBadge>
      <Icon>{getCharacterIcon(activeCharacter)}</Icon>
      <Name>{activeCharacter.nameEn}</Name>
      <Role>{activeCharacter.role}</Role>
    </CharacterBadge>
  </CharacterDisplay>
  
  {/* Speech bubble */}
  <SpeechBubble position="top-left" dir="rtl">
    <Message>{activeCharacter.currentMessage}</Message>
    {isSpeaking && <AudioWaveIndicator />}
  </SpeechBubble>
  
  {/* Objectives sidebar (collapsible) */}
  <ObjectivesSidebar>
    <h4>Objectifs :</h4>
    {currentScene.objectives.map((obj, i) => (
      <Objective key={i} completed={objectiveStates[i]}>
        {objectiveStates[i] ? '✅' : '⬜'} {obj}
      </Objective>
    ))}
  </ObjectivesSidebar>
  
  {/* Vocabulary helper (collapsible) */}
  <VocabularyHelper>
    <summary>💡 Vocabulaire utile</summary>
    <WordList>
      {getSceneVocabulary(currentScene).map(word => (
        <Word key={word.ar}>
          <span className="ar">{word.ar}</span> = 
          <span className="fr">{word.fr}</span>
        </Word>
      ))}
    </WordList>
  </VocabularyHelper>
  
  {/* Chat interface */}
  <ChatInterface>
    <MessageHistory>
      {messages.map(msg => (
        <MessageBubble 
          character={msg.character}
          text={msg.text}
          avatar={msg.character?.avatar}
        />
      ))}
    </MessageHistory>
    <ChatInput 
      placeholder="Réponds en arabe..."
      dir="rtl"
    />
  </ChatInterface>
</StoryMode>
```

