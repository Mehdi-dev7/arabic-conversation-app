### Automatic Level Progression

```typescript
interface LevelProgressionCriteria {
  vocabularySize: number;
  comprehensionScore: number;
  productionScore: number;
  conversationMinutes: number;
}

function canLevelUp(user: User): boolean {
  const progress = user.progress;
  
  switch (user.currentLevel) {
    case 'vocabulary_acquisition': // Level 1 → 2
      return progress.vocabularySize >= 300 && 
             progress.comprehensionScore >= 70;
    
    case 'comprehension': // Level 2 → 3
      return progress.comprehensionScore >= 80 && 
             progress.productionScore >= 50;
    
    case 'assisted_conversation': // Level 3 → 4
      return progress.conversationMinutes >= 120 && // 2 hours
             progress.productionScore >= 75;
    
    default:
      return false;
  }
}

// Celebratory level-up modal
if (canLevelUp(user)) {
  showModal({
    title: "🎉 Félicitations !",
    message: `Tu es prêt pour le Niveau ${nextLevel.number} : ${nextLevel.nameEn} !`,
    action: "Commencer →",
    animation: "confetti",
  });
}
```

