### AI Prompt for Subtitle Generation

```typescript
// System prompt addition for levels with subtitles
const systemPromptWithSubtitles = `
${baseSystemPrompt}

IMPORTANT - SUBTITLE FORMAT:
After each Arabic response, add a line break and provide a natural French translation.
Use this exact format:

[Your Arabic response]
TRADUCTION: [French translation]

Example:
مرحباً! كيف حالك؟ هل أنت جاهز لنتعلم؟
TRADUCTION: Bonjour ! Comment vas-tu ? Es-tu prêt à apprendre ?

Rules for translations:
- Natural, conversational French (not word-for-word)
- Keep it concise
- Don't translate proper nouns
- Use same tone as Arabic (formal/informal)
`;

// Parse AI response to separate Arabic and translation
function parseAIResponse(response: string): {
  arabic: string;
  translation: string | null;
} {
  const parts = response.split('TRADUCTION:');
  
  if (parts.length === 2) {
    return {
      arabic: parts[0].trim(),
      translation: parts[1].trim(),
    };
  }
  
  // Fallback if AI didn't provide translation
  return {
    arabic: response.trim(),
    translation: null,
  };
}

// Display logic
const { arabic, translation } = parseAIResponse(aiMessage);

return (
  <MessageBubble>
    <ArabicText>{arabic}</ArabicText>
    {showSubtitles && translation && (
      <Subtitle>{translation}</Subtitle>
    )}
  </MessageBubble>
);
```

