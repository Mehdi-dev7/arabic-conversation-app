### Implementation in API Route

```typescript
// app/api/chat/route.ts
export async function POST(req: Request) {
  const { message, userId, scenarioId } = await req.json();
  const user = await getUser(userId);
  const levelConfig = levelConfigs[user.currentLevel];
  
  // Build system prompt with subtitle instruction if needed
  let systemPrompt = buildSystemPrompt(user.currentLevel, user.language);
  
  if (levelConfig.subtitles.enabled || user.preferences.subtitlesEnabled) {
    systemPrompt += `

IMPORTANT: After each Arabic response, add a translation:
TRADUCTION: [natural French translation]`;
  }
  
  // Call Claude API
  const response = await anthropic.messages.create({
    model: "claude-sonnet-4-20250514",
    system: systemPrompt,
    messages: conversationHistory,
  });
  
  // Parse response
  const { arabic, translation } = parseAIResponse(response.content[0].text);
  
  return NextResponse.json({
    arabic,
    translation,
    showSubtitles: levelConfig.subtitles.enabled || user.preferences.subtitlesEnabled,
  });
}
```

