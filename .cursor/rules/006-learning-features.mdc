### Subtitle System (Activatable/Deactivatable)

**PURPOSE:** Help absolute beginners who know basic grammar/conjugation but lack vocabulary to understand AI responses.

```typescript
interface SubtitleConfig {
  enabled: boolean;           // Show subtitles or not
  toggleable: boolean;        // Can user turn on/off?
  language: 'french' | 'english'; // Subtitle language
  position: 'below_message' | 'overlay'; // Placement
  style: 'subtle' | 'prominent'; // Visual style
  autoDetectLevel: boolean;   // Auto-enable for beginners?
}

// Level-specific subtitle defaults
const subtitlesByLevel = {
  vocabulary_acquisition: {
    enabled: true,            // ON by default (they need it!)
    toggleable: true,
    language: 'french',
    position: 'below_message',
    style: 'subtle',
  },
  
  comprehension: {
    enabled: false,           // OFF by default (testing comprehension)
    toggleable: true,         // But can turn on if struggling
    language: 'french',
    position: 'below_message',
    style: 'subtle',
  },
  
  assisted_conversation: {
    enabled: true,            // ON by default (assistance phase)
    toggleable: true,
    language: 'french',
    position: 'below_message',
    style: 'subtle',
  },
  
  immersion: {
    enabled: false,           // OFF completely (immersion = no crutches)
    toggleable: false,        // Can't turn on at this level
  },
};
```

