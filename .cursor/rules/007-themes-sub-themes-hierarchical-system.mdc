## 📚 THEMES & SUB-THEMES (Hierarchical System)


### Theme Structure

```typescript
interface Theme {
  id: string;
  name: string;          // Arabic name
  nameEn: string;        // English/French name
  icon: string;          // Emoji
  level: 1 | 2 | 3 | 4;  // Required level
  subthemes: SubTheme[];
  progress: number;      // 0-100%
  freeAccess: boolean;
}

interface SubTheme {
  id: string;
  name: string;
  nameEn: string;
  vocabulary: Word[];
  scenarios?: Scenario[];
  subthemes?: SubTheme[]; // Nested sub-themes possible!
  completed: boolean;
}

interface Word {
  ar: string;
  fr: string;
  pronunciation?: string;
  example?: string;
}
```

