  );
}
```

### React Native (`mobile/`)
- Préférer **`View` / `Text` / `Pressable` / `FlatList`** + **`StyleSheet.create`**, alias `@/` → `src/` (voir `mobile/babel.config.js`).
- **RTL arabe :** `textAlign: 'right'`, `writingDirection: 'rtl'` sur `Text` ; pas de prop `dir` (non typée sur RN).
- **Animations :** `react-native-reanimated` ; avatar **`react-native-svg`** (pas Framer Motion).
- **Données / API :** `src/api/chat.ts` + **`EXPO_PUBLIC_API_URL`** vers le backend Next.js.

### API Routes
```typescript
// app/api/chat/route.ts
import { NextRequest, NextResponse } from 'next/server';

export async function POST(req: NextRequest) {
  try {
    // 1. Authenticate user
    const user = await authenticate(req);
    
    // 2. Validate request body
    const { message, scenarioId, language } = await req.json();
    
    // 3. Check rate limits
    await checkRateLimits(user.id, user.plan);
    
    // 4. Call Claude API
    const response = await generateResponse(message, scenarioId, language, user.level);
    
    // 5. Save to database
    await saveConversation(user.id, message, response);
    
    // 6. Return response
    return NextResponse.json({ success: true, response });
    
  } catch (error) {
    console.error('Chat API error:', error);
    return NextResponse.json(
      { error: error.message }, 
      { status: error.status || 500 }
    );
  }
}
```

